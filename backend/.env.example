# MongoDB connection string for a cloud-hosted database.
# Replace with your MongoDB Atlas or other MongoDB URI.
MONGODB_URI=mongodb+srv://<your_db_user>:<your_db_password>@<your_cluster>.mongodb.net
MONGODB_DB_NAME=ai_resume_platform

# Default seeded login account
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=Password123!

# Auto-apply: when true, the browser fills the application form and takes
# screenshots but stops just before the real submit click. Use this for
# testing against live job postings without actually applying.
AUTO_APPLY_DRY_RUN=true